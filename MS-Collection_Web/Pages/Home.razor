@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@using MS_Collection_WbApi.Models
@using MS_Collection_Web.Models
@inject CarritoService carritoService
@inject IJSRuntime JS


<PageTitle>Home</PageTitle>

<style>
    .logo-text {
        font-weight: bold;
        font-size: 2rem;
        color: #3a2e2c;
    }

    .search-container {
        position: relative;
        width: 50%;
        min-width: 250px;
    }

    .search-bar {
        width: 100%;
        border-radius: 50px;
        border: 2px solid #c19d87;
        padding: 10px 50px 10px 20px;
        font-size: 1.1rem;
        color: #6c5a53;
    }

    .search-btn {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        border: none;
        background-color: transparent;
        color: #c19d87;
        font-size: 1.4rem;
        cursor: pointer;
    }

    .main-banner {
        position: relative;
        text-align: center;
        color: white;
    }

        .main-banner img {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
        }

    .banner-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        width: 100%;
    }

    .title-highlight {
        font-size: 2.5rem;
        font-weight: bold;
    }

    .section-title {
        text-align: center;
        margin-top: 2rem;
        font-size: 2rem;
        color: #3a2e2c;
    }

    @@media (max-width: 576px) {
        .search-container {
            width: 80%;
        }

        .search-bar {
            padding: 10px 45px 10px 15px;
            font-size: 1rem;
        }

        .search-btn {
            right: 10px;
            font-size: 1.2rem;
        }
    }

    .card-title {
        color: #3a2e2c;
        font-weight: bold;
    }

    .card-text {
        color: #6c5a53;
        font-size: 0.9rem;
    }

    .btn {
        border-radius: 20px;
    }

    .card-img-top-wrapper {
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f8f6f5;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
        padding: 0.5rem;
    }

    .card-img-top {
        height: 100%;
        width: auto;
        max-width: 100%;
        object-fit: scale-down;
        display: block;
    }

    .toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background-color: #c19d87;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: bold;
        z-index: 1000;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.2);
    }
</style>

<!-- BANNER -->
<div class="main-banner">
    <img src="fondobusqueda.jpg" alt="Banner" />
    <div class="banner-content">
        <img src="Logo.png" alt="Logo" class="mb-3" style="max-width: 80px;" />
        <div class="title-highlight">MS Joyería y relojería</div>

        <div class="d-flex justify-content-center mt-4">
            <div class="search-container">
                <input type="text" class="form-control search-bar" placeholder="Buscar productos..."
                       @bind="textoBusqueda" @onkeypress="OnKeyPress" />
                <button class="search-btn" @onclick="BuscarProducto">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- COLECCIÓN -->
<section class="my-5">
    <h2 class="section-title">@tituloSeccion</h2>
    <div class="container">
        @if (!string.IsNullOrEmpty(mensajeBusqueda))
        {
            <div style="text-align:center; padding:3rem;">
                <i class="bi bi-search" style="font-size: 4rem; color: #c19d87;"></i>
                <h4 style="margin-top: 1rem; color:#6c5a53;">@mensajeBusqueda</h4>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var producto in productosNuevos)
                {
                    var stockDisponible = stockOriginal.ContainsKey(producto.Id)
                    ? (stockOriginal[producto.Id] ?? 0) - carritoService.ObtenerCantidadEnCarrito(producto.Id)
                    : 0;

                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-img-top-wrapper">
                                <img src="@producto.ImagenURL" class="card-img-top" alt="@producto.Nombre">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-center">@producto.Nombre</h5>
                                <p class="card-text">
                                    <strong>Categoría:</strong> @producto.CategoriaId<br />
                                    <strong>Código:</strong> @producto.Codigo <br />
                                    <strong>Cantidad disponible:</strong> @stockDisponible
                                </p>
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold">$@producto.PrecioVenta</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <a href="/producto-detalle/@producto.Id" class="btn btn-outline-secondary btn-sm w-50 me-1 text-center">Ver detalles</a>
                                        <button class="btn btn-primary btn-sm w-50"
                                                @onclick="@(async () => await AgregarAlCarrito(producto))"
                                                disabled="@((stockDisponible <= 0))">
                                            🛒 Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@if (mensajeVisible)
{
    <div class="toast">@mensaje</div>
}

@code {
    List<Producto> productosNuevos = new();
    Dictionary<int, int?> stockOriginal = new();
    string textoBusqueda = string.Empty;
    string tituloSeccion = "Nueva Colección";
    string mensajeBusqueda = string.Empty;
    string mensaje = "";
    bool mensajeVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    async Task CargarProductos()
    {
        try
        {
            var todos = await Http.GetFromJsonAsync<List<Producto>>("https://localhost:44300/api/Producto/lista");
            productosNuevos = todos.OrderByDescending(p => p.Id).Take(8).ToList();
            stockOriginal = productosNuevos.ToDictionary(p => p.Id, p => p.StockActual);
            tituloSeccion = "Nueva Colección";
            mensajeBusqueda = string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar productos: " + ex.Message);
        }
    }

    async Task BuscarProducto()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            await CargarProductos();
            return;
        }

        try
        {
            var resultado = await Http.GetFromJsonAsync<List<Producto>>($"https://localhost:44300/api/Producto/buscar/{textoBusqueda}");

            if (resultado != null && resultado.Any())
            {
                productosNuevos = resultado;
                stockOriginal = productosNuevos.ToDictionary(p => p.Id, p => p.StockActual);
                mensajeBusqueda = string.Empty;
            }
            else
            {
                productosNuevos = new();
                mensajeBusqueda = $"😢 No se encontraron resultados para \"{textoBusqueda}\".";
            }

            tituloSeccion = "Resultados de búsqueda";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al buscar productos: " + ex.Message);
        }
    }

    async Task AgregarAlCarrito(Producto producto)
    {
        int stockDisponible = stockOriginal.ContainsKey(producto.Id)
            ? stockOriginal[producto.Id] ?? 0
            : producto.StockActual ?? 0;

        int enCarrito = carritoService.ObtenerCantidadEnCarrito(producto.Id);

        if (enCarrito >= stockDisponible)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Solo hay {stockDisponible} unidades disponibles para '{producto.Nombre}'.");
            return;
        }

        carritoService.AgregarItem(producto);

        await JS.InvokeVoidAsync("alert", $"✅ Producto '{producto.Nombre}' agregado al carrito.");
    }

    async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarProducto();
        }
    }
}
