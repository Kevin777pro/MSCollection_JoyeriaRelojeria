    private async Task CrearUsuario()
    {
        // Validaciones individuales
        var regexCedula = new Regex(@"^\d-\d{4}-\d{4}$");
        var regexTelefono = new Regex(@"^\d{3}-\d{8}$");
        var regexCorreo = new Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");

        if (!regexCedula.IsMatch(usuario.Cedula))
        {
            await JS.InvokeVoidAsync("alert", "La cédula debe tener el formato 0-0000-0000.");
            return;
        }

        if (await ExisteCedula(usuario.Cedula))
        {
            await JS.InvokeVoidAsync("alert", "La cédula ya está registrada.");
            return;
        }

        if (string.IsNullOrWhiteSpace(usuario.NombreCompleto))
        {
            await JS.InvokeVoidAsync("alert", "El nombre completo es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(usuario.Direccion))
        {
            await JS.InvokeVoidAsync("alert", "La dirección es obligatoria.");
            return;
        }

        if (string.IsNullOrWhiteSpace(usuario.User))
        {
            await JS.InvokeVoidAsync("alert", "El nombre de usuario es obligatorio.");
            return;
        }

        if (await ExisteUsuario(usuario.User))
        {
            await JS.InvokeVoidAsync("alert", "El nombre de usuario ya existe.");
            return;
        }

        if (string.IsNullOrWhiteSpace(usuario.Contraseña) || usuario.Contraseña.Length < 6)
        {
            await JS.InvokeVoidAsync("alert", "La contraseña debe tener al menos 6 caracteres.");
            return;
        }

        // if (string.IsNullOrWhiteSpace(usuario.Email) || !usuario.Email.Contains("@") || !usuario.Email.Contains("."))
        // {
        //     await JS.InvokeVoidAsync("alert", "Ingrese un correo válido (ej: usuario@dominio.com).");
        //     return;
        // }

        if (!string.IsNullOrWhiteSpace(usuario.Email))
        {
            if (!regexCorreo.IsMatch(usuario.Email))
            {
                await JS.InvokeVoidAsync("alert", "El correo electrónico no es válido.");
                return;
            }

            if (await ExisteCorreo(usuario.Email))
            {
                await JS.InvokeVoidAsync("alert", "El correo ya está registrado.");
                return;
            }
        }

        if (!regexTelefono.IsMatch(usuario.Telefono))
        {
            await JS.InvokeVoidAsync("alert", "El teléfono debe tener el formato 000-00000000.");
            return;
        }

        if (await ExisteTelefono(usuario.Telefono))
        {
            await JS.InvokeVoidAsync("alert", "El teléfono ya está registrado.");
            return;
        }

        // Asignar valores por defecto
        usuario.Rol = "Cliente";
        usuario.Estado = true;

        var response = await Http.PostAsJsonAsync("api/usuario/crear", usuario);
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Usuario creado correctamente.");
            Navigation.NavigateTo("/login");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al crear el usuario. Verifica que no esté duplicado.");
        }
    }

    // Métodos de validaciones
    private async Task<bool> ExisteCedula(string cedula)
    {
        return await Http.GetFromJsonAsync<bool>($"api/usuario/existeCedula/{cedula}");
    }

    private async Task<bool> ExisteUsuario(string user)
    {
        return await Http.GetFromJsonAsync<bool>($"api/usuario/existeUser/{user}");
    }

    private async Task<bool> ExisteCorreo(string email)
    {
        return await Http.GetFromJsonAsync<bool>($"api/usuario/existeCorreo/{email}");
    }

    private async Task<bool> ExisteTelefono(string telefono)
    {
        return await Http.GetFromJsonAsync<bool>($"api/usuario/existeTelefono/{telefono}");
    }


    public class ModeloUsuario
    {
        [Required(ErrorMessage = "La cédula es obligatoria")]
        public string Cedula { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre completo es obligatorio")]
        public string NombreCompleto { get; set; } = string.Empty;

        [Required(ErrorMessage = "La dirección es obligatoria")]
        public string Direccion { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre de usuario es obligatorio")]
        [RegularExpression(@"^[a-zA-Z0-9_]+$", ErrorMessage = "Solo letras, números y guión bajo")]
        public string User { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria")]
        public string Contraseña { get; set; } = string.Empty;

        [Required(ErrorMessage = "El email es obligatorio")]
        [EmailAddress(ErrorMessage = "Email inválido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "El teléfono es obligatorio")]
        public string Telefono { get; set; } = string.Empty;

        public string Rol { get; set; } = "Cliente";
        public bool Estado { get; set; } = true;
    }
}

<div class="crear-cuenta-container">
    <div class="form-box">
        <!-- Encabezado -->
        <div class="header-section">
            <div>
                <h2>Vamos<br /><strong>Crea tu Cuenta!</strong></h2>
            </div>
            <img src="logo.png" alt="Logo" class="logo-img" />
        </div>

        <!-- Inputs -->
        <div class="input-section">
            <div class="input-group-custom">
                <i class="bi bi-person-vcard icon-left"></i>
                <input type="text" class="form-control custom-input" placeholder="Cédula" @bind="usuario.Cedula" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-person icon-left"></i>
                <input type="text" class="form-control custom-input" placeholder="Nombre completo" @bind="usuario.NombreCompleto" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-geo-alt icon-left"></i>
                <input type="text" class="form-control custom-input" placeholder="Dirección" @bind="usuario.Direccion" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-person-circle icon-left"></i>
                <input type="text" class="form-control custom-input" placeholder="Usuario" @bind="usuario.User" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-lock icon-left"></i>
                <input type="password" class="form-control custom-input" placeholder="Contraseña" @bind="usuario.Contraseña" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-envelope icon-left"></i>
                <input type="email" class="form-control custom-input" placeholder="Email" @bind="usuario.Email" />
            </div>
            <div class="input-group-custom">
                <i class="bi bi-telephone icon-left"></i>
                <input type="text" class="form-control custom-input" placeholder="Teléfono" @bind="usuario.Telefono" />
            </div>
            <input type="submit" class="submit-btn" value="Registrarse" @onclick="CrearUsuario" />
            <div style="text-align: center; margin-top: 1rem;">
                <span>¿Ya tienes una cuenta?</span>
                <a href="/login" style="color: #c59180; font-weight: bold; text-decoration: none; margin-left: 0.5rem;">Inicia sesión</a>
            </div>
        </div>
    </div>
</div>
