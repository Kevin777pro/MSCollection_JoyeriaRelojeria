@page "/Usuarios"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject HttpClient Http

<div class="contenedor-principal">
    <main class="contenido">
        <div class="barra-superior">
            <div class="titulo-seccion">Usuarios</div>
            <button class="btn-agregar" @onclick="NuevoUsuario">+ Agregar</button>
        </div>
        @*  Tabla de gestión de usuarios *@
        <table class="tabla-productos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Teléfono</th>
                    <th>Cédula</th>
                    <th>Dirección</th>
                    <th>Editar</th>
                    <th>Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in listaUsuarios)
                {
                    <tr>
                        <td>@usuario.NombreCompleto</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.Rol</td>
                        <td>@usuario.Telefono</td>
                        <td>@usuario.Cedula</td>
                        <td>@usuario.Direccion</td>
                        <td><button class="btn-icono" @onclick="() => EditarUsuario(usuario)">✏</button></td>
                        <td><button class="btn-icono" @onclick="() => ConfirmarEliminar(usuario)">🗑</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </main>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal-contenido">
                <button class="cerrar-modal" @onclick="() => mostrarModal = false">×</button>
                <h2>@(usuarioSeleccionado.Id == 0 ? "Agregar Usuario" : "Editar Usuario")</h2>
                @* Formulario de registro de usuario *@
                <div class="formulario-producto">
                    <div class="columna">
                        <input type="text" @bind="usuarioSeleccionado.NombreCompleto" placeholder="Nombre" />
                        @* Validacion *@
                        @if (!string.IsNullOrWhiteSpace(errorNombre))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorNombre</div>
                        }

                        <input type="email" @bind="usuarioSeleccionado.Email" placeholder="Correo" />
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorCorreo))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorCorreo</div>
                        }

                        @if (usuarioSeleccionado.Id == 0)
                        {
                            <input type="password" @bind="usuarioSeleccionado.Contraseña" placeholder="Contraseña" />
                            @*  Validación *@
                            @if (!string.IsNullOrWhiteSpace(errorContrasena))
                            {
                                <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorContrasena</div>
                            }
                        }

                        <input type="text" @bind="usuarioSeleccionado.User" placeholder="Nombre de usuario" />
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorUser))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorUser</div>
                        }

                        <input type="text" @bind="usuarioSeleccionado.Telefono" placeholder="Teléfono" />
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorTelefono))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorTelefono</div>
                        }

                        <input type="text" @bind="usuarioSeleccionado.Cedula" placeholder="Cedula" />
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorCedula))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorCedula</div>
                        }

                        <input type="text" @bind="usuarioSeleccionado.Direccion" placeholder="Direccion" />
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorDireccion))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorDireccion</div>
                        }

                        <select @bind="usuarioSeleccionado.Rol">
                            <option disabled value="">Selecciona un rol</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Vendedor">Vendedor</option>
                            <option value="cliente">Cliente</option>
                        </select>
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorRol))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorRol</div>
                        }
                    </div>
                </div>

                <button class="btn-registrar" @onclick="GuardarUsuario">Guardar</button>
            </div>
        </div>
    }

    @if (mostrarModalConfirmacion)
    {
        <div class="modal-overlay">
            <div class="modal-contenido">
                <h2>¿Estás seguro?</h2>
                <p>¿Deseas eliminar al usuario <strong>@usuarioAEliminar?.NombreCompleto</strong>?</p>
                <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem;">
                    <button class="btn-registrar" style="background-color: #d9534f;" @onclick="EliminarUsuarioConfirmado">Sí, eliminar</button>
                    <button class="btn-registrar" style="background-color: #6c757d;" @onclick="() => mostrarModalConfirmacion = false">Cancelar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Variables de validación
    string errorNombre = "", errorCorreo = "", errorContrasena = "", errorUser = "", errorTelefono = "", errorCedula = "", errorDireccion = "", errorRol = "";

    // Variables de proceso
    List<Usuario> listaUsuarios = new();
    Usuario usuarioSeleccionado = new();
    Usuario? usuarioAEliminar;
    bool mostrarModal = false;
    bool mostrarModalConfirmacion = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    async Task CargarUsuarios()
    {
        listaUsuarios = await Http.GetFromJsonAsync<List<Usuario>>("api/usuario/lista");
    }

    void NuevoUsuario()
    {
        usuarioSeleccionado = new Usuario();
        mostrarModal = true;
    }

    void EditarUsuario(Usuario usuario)
    {
        usuarioSeleccionado = new Usuario
            {
                Id = usuario.Id,
                NombreCompleto = usuario.NombreCompleto,
                Email = usuario.Email,
                User = usuario.User,
                Rol = usuario.Rol,

                Telefono = usuario.Telefono,
                Cedula = usuario.Cedula,
                Direccion = usuario.Direccion
            };
        mostrarModal = true;
    }

    async Task GuardarUsuario()
    {
        LimpiarErrores();

        bool tieneErrores = false;

        var regexNombre = new Regex("^[a-zA-ZÁÉÍÓÚáéíóúÑñ ]+$");
        var regexTelefono = new Regex(@"^\d{3}-\d{8}$");
        var regexCedula = new Regex(@"^\d-\d{4}-\d{4}$");
        var regexCorreo = new Regex(@"^[^@\s]+@[^@\s]+\.(com)$");

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.NombreCompleto) || !regexNombre.IsMatch(usuarioSeleccionado.NombreCompleto))
        {
            errorNombre = "Ingrese un nombre válido (sin símbolos).";
            tieneErrores = true;
        }

        if (!string.IsNullOrWhiteSpace(usuarioSeleccionado.Email))
        {
            if (!regexCorreo.IsMatch(usuarioSeleccionado.Email))
            {
                errorCorreo = "Ingrese un correo válido (ej: usuario@dominio.com).";
                tieneErrores = true;
            }
            else if (listaUsuarios.Any(u => u.Email == usuarioSeleccionado.Email && u.Id != usuarioSeleccionado.Id))
            {
                errorCorreo = "Este correo ya está registrado.";
                tieneErrores = true;
            }
        }

        if (usuarioSeleccionado.Id == 0 && (string.IsNullOrWhiteSpace(usuarioSeleccionado.Contraseña) || usuarioSeleccionado.Contraseña.Length < 6))
        {
            errorContrasena = "Ingrese una contraseña válida de al menos 6 caracteres.";
            tieneErrores = true;
        }

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.User))
        {
            errorUser = "Ingrese un nombre de usuario.";
            tieneErrores = true;
        }
        else if (listaUsuarios.Any(u => u.User == usuarioSeleccionado.User && u.Id != usuarioSeleccionado.Id))
        {
            errorUser = "Este nombre de usuario ya está registrado.";
            tieneErrores = true;
        }

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.Telefono) || !regexTelefono.IsMatch(usuarioSeleccionado.Telefono))
        {
            errorTelefono = "Ingrese un teléfono válido (XXX-XXXXXXXX).";
            tieneErrores = true;
        }
        else if (listaUsuarios.Any(u => u.Telefono == usuarioSeleccionado.Telefono && u.Id != usuarioSeleccionado.Id))
        {
            errorTelefono = "Este teléfono ya está registrado.";
            tieneErrores = true;
        }

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.Cedula) || !regexCedula.IsMatch(usuarioSeleccionado.Cedula))
        {
            errorCedula = "Ingrese una cédula válida (0-0000-0000).";
            tieneErrores = true;
        }
        else if (listaUsuarios.Any(u => u.Cedula == usuarioSeleccionado.Cedula && u.Id != usuarioSeleccionado.Id))
        {
            errorCedula = "Esta cédula ya está registrada.";
            tieneErrores = true;
        }

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.Direccion))
        {
            errorDireccion = "La dirección no puede estar vacía.";
            tieneErrores = true;
        }

        if (string.IsNullOrWhiteSpace(usuarioSeleccionado.Rol))
        {
            errorRol = "Seleccione un rol.";
            tieneErrores = true;
        }

        if (tieneErrores)
            return;

        // Guardado
        if (usuarioSeleccionado.Id == 0)
        {
            await Http.PostAsJsonAsync("api/usuario/crear", usuarioSeleccionado);
        }
        else
        {
            await Http.PutAsJsonAsync($"api/Usuario/actualizar/{usuarioSeleccionado.Id}", usuarioSeleccionado);
        }

        mostrarModal = false;
        await CargarUsuarios();
    }

    void LimpiarErrores()
    {
        errorNombre = errorCorreo = errorContrasena = errorUser = errorTelefono = errorCedula = errorDireccion = errorRol = "";
    }


    void ConfirmarEliminar(Usuario usuario)
    {
        usuarioAEliminar = usuario;
        mostrarModalConfirmacion = true;
    }

    async Task EliminarUsuarioConfirmado()
    {
        if (usuarioAEliminar != null)
        {
            await Http.DeleteAsync($"api/usuario/eliminar/{usuarioAEliminar.Id}");
            mostrarModalConfirmacion = false;
            await CargarUsuarios();
        }
    }

    public class Usuario
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public string Contraseña { get; set; } = "";
        public string Rol { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Cedula { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string User { get; set; } = "";
    }
}
<style>
    /* Estilo general */

    .contenido {
        max-width: 1200px;
        margin: auto;
        background-color: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    /* Barra superior */
    .barra-superior {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .titulo-seccion {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
    }

    /* Botón agregar */
    .btn-agregar {
        background-color: #bb8e6b;
        color: #fff;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .btn-agregar:hover {
            background-color: #ede0d4;
            color: #bb8e6b;
        }

    /* Tabla */
    .tabla-contenedor {
        overflow: auto;
    }

    .tabla-productos {
        width: 100%;
        border-collapse: collapse;
    }

        .tabla-productos th,
        .tabla-productos td {
            padding: 0.5rem;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .tabla-productos th {
            background-color: #EAE6E3;
            font-weight: 600;
            color: #555;
        }

        .tabla-productos tr:hover {
            background-color: #F9F4EF;
        }

    /* Botones de iconos: editar y eliminar */
    .btn-icono {
        border: none;
        padding: 0.45rem 0.6rem;
        border-radius: 0.5rem;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Editar */
    .btn-editar {
        background-color: #ede0d4;
        color: #bb8e6b;
    }

        .btn-editar:hover {
            background-color: #d9a98b;
            color: #fff;
            transform: scale(1.08);
        }

    /* Eliminar */
    .btn-eliminar {
        background-color: #ede0d4;
        color: #bb8e6b;
    }

        .btn-eliminar:hover {
            background-color: #bb8e6b;
            color: #fff;
            transform: scale(1.08);
        }


    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
    }

    .modal-contenido {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        width: 90%;
        max-width: 700px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        position: relative;
    }

    /* Botón cerrar modal */
    .cerrar-modal {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    /* Formularios */
    .formulario-productos {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .columna label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 500;
        color: #374151;
    }

    .columna input,
    .columna select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
    }

    /* Mensaje error */
    .mensaje-error {
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: #dc2626;
    }

    /* Botones */
    .btn-registrar,
    .btn-eliminar-detalle {
        color: white;
        border: none;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 1rem;
        transition: background-color 0.2s ease;
    }

    .btn-eliminar-detalle {
        background-color: #ef4444;
    }

    .btn-registrar {
        background-color: #10b981;
    }

    .btn-eliminar-detalle:hover {
        background-color: #dc2626;
    }

    .btn-registrar:hover {
        background-color: #059669;

    }

</style>
