@page "/Inventario"
@inject HttpClient Http
@inject IJSRuntime JS

<main class="contenido">
    <div class="barra-superior">
        <div class="titulo-seccion">Registrar Movimientos de Inventario</div>
    </div>


    @* Formulario para ingresar movimientos *@
    <div class="mb-3">
        <div class="formulario-producto">
            <div class="columna">
                <label>Producto</label>
                <select class="form-select" @bind="nuevoMovimiento.ProductoId">
                    <option value="">Seleccione un producto</option>
                    @foreach (var producto in productos)
                    {
                        <option value="@producto.Id">@producto.Nombre</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label>Cantidad</label>
                <input type="number" class="form-control" @bind="nuevoMovimiento.Cantidad" placeholder="Cantidad" min="1" />
            </div>
            <div class="mb-3">
                <label>Tipo de movimiento</label>
                <select class="form-select" @onchange="ActualizarTipoMovimiento">
                    <option value="1">Entrada</option>
                    <option value="0">Salida</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Observación</label>
                <input type="text" class="form-control" @bind="nuevoMovimiento.Observacion" placeholder="Observación" />
            </div>
        </div>
    </div>
    @* AGREGAR MOVIEMIENTO *@
    <button class="btn-registrar" @onclick="AgregarMovimiento">Agregar a lista</button>

    <hr />

    <h5>Movimientos Agregados:</h5>
    @if (movimientos.Count == 0)
    {
        <p>No hay movimientos aún.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Tipo</th>
                    <th>Observación</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientos)
                {
                    <tr>
                        <td>@productos.FirstOrDefault(p => p.Id == m.ProductoId)?.Nombre</td>
                        <td>@m.Cantidad</td>
                        <td>@(m.EsEntrada ? "Entrada" : "Salida")</td>
                        <td>@m.Observacion</td>
                        <td><button class="btn-icono btn-eliminar" @onclick="() => RemoverMovimiento(m)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn-registrar" @onclick="EnviarMovimientos">Registrar todos</button>
    }

    <h5>Historial de Movimientos Registrados:</h5>

    @if (movimientosRegistrados.Count == 0)
    {
        <p>No hay movimientos registrados aún.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Tipo</th>
                    <th>Observación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientosRegistrados.OrderByDescending(m => m.fechaRegistro))
                {
                    <tr>
                        <td>@m.fechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@m.productoNombre</td>
                        <td>@m.Cantidad</td>
                        <td>@(m.EsEntrada ? "Entrada" : "Salida")</td>
                        <td>@m.Observacion</td>
                    </tr>
                }
            </tbody>
        </table>
    }


</main>


@code {

    private List<ProductoDto> productos = new();
    private List<MovimientoInventarioDto> movimientos = new();
    private MovimientoInventarioDto nuevoMovimiento = new() { EsEntrada = true };
    private int usuarioId = 12;

    protected override async Task OnInitializedAsync()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("https://localhost:44300/api/Producto/lista");
        movimientosRegistrados = await Http.GetFromJsonAsync<List<MovimientoInventarioRegistradoDto>>("https://localhost:44300/api/inventario/movimientos");
    }

    private void ActualizarTipoMovimiento(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        nuevoMovimiento.EsEntrada = valor == "1";
    }

    private void RemoverMovimiento(MovimientoInventarioDto movimiento)
    {
        movimientos.Remove(movimiento);
    }

    private async Task EnviarMovimientos()
    {
        if (movimientos.Count == 0)
        {
            await JS.InvokeVoidAsync("alert", "Debe agregar al menos un movimiento.");
            return;
        }

        var payload = new MovimientoInventarioRequest
            {
                UsuarioId = usuarioId,
                Movimientos = movimientos
            };

        var response = await Http.PostAsJsonAsync("/api/inventario/movimientos-multiples", payload);

        if (response.IsSuccessStatusCode)
        {
            movimientos.Clear();
            await JS.InvokeVoidAsync("alert", "¡Movimientos registrados!");
            await OnInitializedAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al registrar movimientos.");
        }
    }

    private async Task AgregarMovimiento()
    {
        // Validaciones
        if (nuevoMovimiento.ProductoId <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar un producto.");
            return;
        }

        if (nuevoMovimiento.Cantidad <= 0)
        {
            await JS.InvokeVoidAsync("alert", "La cantidad debe ser mayor que cero.");
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoMovimiento.Observacion))
        {
            await JS.InvokeVoidAsync("alert", "Debe ingresar una observación.");
            return;
        }

        // Validación: evitar movimientos duplicados (opcional)
        var yaExiste = movimientos.Any(m =>
            m.ProductoId == nuevoMovimiento.ProductoId &&
            m.EsEntrada == nuevoMovimiento.EsEntrada &&
            m.Observacion == nuevoMovimiento.Observacion);

        if (yaExiste)
        {
            await JS.InvokeVoidAsync("alert", "Este movimiento ya fue agregado.");
            return;
        }

        if (nuevoMovimiento.ProductoId > 0 && nuevoMovimiento.Cantidad > 0)
        {
            movimientos.Add(new MovimientoInventarioDto
                {
                    ProductoId = nuevoMovimiento.ProductoId,
                    Cantidad = nuevoMovimiento.Cantidad,
                    EsEntrada = nuevoMovimiento.EsEntrada,
                    Observacion = nuevoMovimiento.Observacion
                });

            // Reiniciar campos
            nuevoMovimiento = new MovimientoInventarioDto { EsEntrada = true };
        }
    }

    private List<MovimientoInventarioRegistradoDto> movimientosRegistrados = new();

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; }
    }

    public class MovimientoInventarioDto
    {
        public int ProductoId { get; set; }
        public int Cantidad { get; set; }
        public bool EsEntrada { get; set; }
        public string Observacion { get; set; } = "";
    }

    public class MovimientoInventarioRequest
    {
        public int UsuarioId { get; set; }
        public List<MovimientoInventarioDto> Movimientos { get; set; } = new();
    }

    public class MovimientoInventarioRegistradoDto
    {
        public int ProductoId { get; set; }
        public string productoNombre { get; set; } = "";
        public int Cantidad { get; set; }
        public bool EsEntrada { get; set; }
        public string Observacion { get; set; } = "";
        public DateTime fechaRegistro { get; set; }
    }


}



<style>
    /* Estilo general */

    .contenido {
        max-width: 1200px;
        margin: auto;
        background-color: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .titulo-seccion {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
    }

    /* Botón agregar */
    .btn-registrar {
        background-color: #bb8e6b;
        color: #fff;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .btn-registrar:hover {
            background-color: #ede0d4;
            color: #bb8e6b;
        }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
    }

    .modal-contenido {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        width: 90%;
        max-width: 700px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        position: absolute;
    }

    /* Botón cerrar modal */
    .cerrar-modal {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;

    }

</style>
