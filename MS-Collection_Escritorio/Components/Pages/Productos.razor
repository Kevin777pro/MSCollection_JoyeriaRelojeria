@page "/Productos"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject HttpClient Http

<div class="contenedor-principal">

    <main class="contenido">
        <div class="barra-superior">
            <div class="titulo-seccion">Productos</div>
            <button class="btn-agregar" @onclick="NuevoProducto">+ Agregar</button>
        </div>

        <h3>Buscar Producto</h3>

        <div class="input-group mb-3">
            <input @bind="terminoBusqueda" class="form-control" placeholder="Buscar pedido..." />
            <button class="btn-agregar" @onclick="BuscarProducto">Buscar</button>
        </div>
        @* Tabla de productos *@
        <table class="tabla-productos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Color</th>
                    <th>Categoría</th>
                    <th>Material</th>
                    <th>Peso</th>
                    <th>Precio de venta</th>
                    <th>Stock</th>
                    <th>Imagen</th>
                    <th>Editar</th>
                    <th>Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in listaProductos)
                {
                    <tr>
                        <td>@producto.Nombre</td>
                        <td>@producto.Codigo</td>
                        <td>@producto.Descripción</td>
                        <td>@producto.Color</td>
                        <td>@producto.Categoria?.Nombre</td>
                        <td>@producto.Material</td>
                        <td>@producto.Peso</td>
                        <td>@producto.PrecioVenta</td>
                        <td>@producto.StockActual</td>
                        <td><img src="@producto.ImagenURL" alt="Imagen" width="50" height="50" /></td>
                        <td><button class="btn-icono btn-editar" @onclick="() => EditarProducto(producto)">✏</button></td>
                        <td><button class="btn-icono btn-eliminar" @onclick="() => EliminarProducto(producto.Id)">🗑</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </main>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal-contenido">
                <button class="cerrar-modal" @onclick="()=>mostrarModal=false">×</button>
                <h2>@(productoSeleccionado.Id == 0 ? "Agregar Producto" : "Editar Producto")</h2>
                <div class="formulario-producto">
                    <div class="columna">
                        <label>Nombre:</label>
                        <input type="text" @bind="productoSeleccionado.Nombre" placeholder="Nombre" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorNombre))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorNombre</div>
                        }
                        <label>Código:</label>
                        <input type="text" @bind="productoSeleccionado.Codigo" placeholder="Código" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorCodigo))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorCodigo</div>
                        }
                        <label>Descripción:</label>
                        <input type="text" @bind="productoSeleccionado.Descripción" placeholder="Descripción" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorDescripcion))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorDescripcion</div>
                        }
                        <label>Color:</label>
                        <input type="text" @bind="productoSeleccionado.Color" placeholder="Color" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorColor))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorColor</div>
                        }
                        <label>Categoría:</label>
                        <select @bind="productoSeleccionado.CategoriaId">
                            <option disabled value="0">Categoría</option>
                            @foreach (var categoria in listaCategorias)
                            {
                                <option value="@categoria.Id">@categoria.Nombre</option>
                            }
                        </select>
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorCategoria))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorCategoria</div>
                        }
                    </div>
                    <div class="columna">
                        <label>Material:</label>
                        <input type="text" @bind="productoSeleccionado.Material" placeholder="Material" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorMaterial))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorMaterial</div>
                        }
                        <label>Peso:</label>
                        <input type="text" @bind="productoSeleccionado.Peso" placeholder="Peso" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorPeso))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorPeso</div>
                        }
                        <label>Precio Venta:</label>
                        <input type="number" @bind="productoSeleccionado.PrecioVenta" placeholder="Precio de venta" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorPrecio))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorPrecio</div>
                        }
                        <label>Stock Actual:</label>
                        <input type="number" @bind="productoSeleccionado.StockActual" placeholder="Stock" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorStock))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorStock</div>
                        }
                        <label>URL Imágen:</label>
                        <input type="text" @bind="productoSeleccionado.ImagenURL" placeholder="URL Imágen" />
                        @* Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorUrl))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorUrl</div>
                        }
                    </div>
                </div>
                <button class="btn-registrar" @onclick="GuardarProducto">Registrar</button>
            </div>
        </div>
    }

    @if (mostrarModalConfirmacion)
    {
        <div class="modal-overlay">
            <div class="modal-contenido">
                <h2>¿Estás seguro?</h2>
                <p>¿Deseas eliminar el producto <strong>@productoAEliminar?.Nombre</strong>?</p>
                <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem;">
                    <button class="btn-registrar" style="background-color: #d9534f;" @onclick="ConfirmarEliminarProducto">Sí, eliminar</button>
                    <button class="btn-registrar" style="background-color: #6c757d;" @onclick="()=>mostrarModalConfirmacion=false">Cancelar</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    // Variables de validaciones
    private string errorNombre = "", errorCodigo = "", errorDescripcion = "", errorColor = "", errorCategoria = "";
    private string errorMaterial = "", errorPeso = "", errorPrecio = "", errorStock = "", errorUrl = "";

    // Variables de procesos
    bool mostrarModal = false;
    List<Producto> listaProductos = new();
    List<Categoria> listaCategorias = new();
    Producto productoSeleccionado = new();
    private string terminoBusqueda = string.Empty;
    bool mostrarModalConfirmacion = false;
    Producto? productoAEliminar = null;


    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    async Task CargarDatos()
    {
        listaProductos = await Http.GetFromJsonAsync<List<Producto>>("api/producto/lista");
        listaCategorias = await Http.GetFromJsonAsync<List<Categoria>>("api/categoria/lista");
    }

    void NuevoProducto()
    {
        productoSeleccionado = new Producto();
        mostrarModal = true;
    }

    void EditarProducto(Producto producto)
    {
        productoSeleccionado = new Producto
            {
                Id = producto.Id,
                Nombre = producto.Nombre,
                Codigo = producto.Codigo,
                Descripción = producto.Descripción,
                Color = producto.Color,
                CategoriaId = producto.CategoriaId,
                Material = producto.Material,
                Peso = producto.Peso,
                PrecioVenta = producto.PrecioVenta,
                StockActual = producto.StockActual,
                ImagenURL = producto.ImagenURL
            };
        mostrarModal = true;
    }

    async Task GuardarProducto()
    {
        // Validaciones
        // Limpiar errores
        errorNombre = errorCodigo = errorDescripcion = errorColor = errorCategoria = "";
        errorMaterial = errorPeso = errorPrecio = errorStock = errorUrl = "";

        bool hayError = false;

        Regex sinSimbolos = new(@"^[a-zA-Z0-9\s]*$");

        if (string.IsNullOrWhiteSpace(productoSeleccionado.Nombre) || !sinSimbolos.IsMatch(productoSeleccionado.Nombre))
        {
            errorNombre = "El nombre es requerido y no debe contener símbolos.";
            hayError = true;
        }

        if (string.IsNullOrWhiteSpace(productoSeleccionado.Codigo))
        {
            errorCodigo = "El código es requerido.";
            hayError = true;
        }

        if (string.IsNullOrWhiteSpace(productoSeleccionado.Descripción))
        {
            errorDescripcion = "La descripción es requerida.";
            hayError = true;
        }

        if (!string.IsNullOrWhiteSpace(productoSeleccionado.Color) && !sinSimbolos.IsMatch(productoSeleccionado.Color))
        {
            errorColor = "El color no debe contener símbolos.";
            hayError = true;
        }

        if (productoSeleccionado.CategoriaId == 0)
        {
            errorCategoria = "Debe seleccionar una categoría.";
            hayError = true;
        }

        if (!string.IsNullOrWhiteSpace(productoSeleccionado.Material) && !sinSimbolos.IsMatch(productoSeleccionado.Material))
        {
            errorMaterial = "El material no debe contener símbolos.";
            hayError = true;
        }

        if (productoSeleccionado.PrecioVenta == null || productoSeleccionado.PrecioVenta <= 0)
        {
            errorPrecio = "El precio de venta es requerido y debe ser mayor a 0.";
            hayError = true;
        }

        if (productoSeleccionado.StockActual < 0 || productoSeleccionado.StockActual.ToString().Contains("."))
        {
            errorStock = "El stock debe ser un número entero positivo.";
            hayError = true;
        }

        if (string.IsNullOrWhiteSpace(productoSeleccionado.ImagenURL))
        {
            errorUrl = "La URL de imagen es requerida.";
            hayError = true;
        }

        if (hayError)
            return;

        //Proceso de Guardado
        if (productoSeleccionado.Id == 0)
        {
            await Http.PostAsJsonAsync("api/producto/Crear", productoSeleccionado);
        }
        else
        {
            await Http.PutAsJsonAsync($"api/producto/{productoSeleccionado.Id}", productoSeleccionado);
        }
        mostrarModal = false;
        await CargarDatos();
    }

    void EliminarProducto(int id)
    {
        productoAEliminar = listaProductos.FirstOrDefault(p => p.Id == id);
        mostrarModalConfirmacion = true;
    }
    private async Task BuscarProducto()
    {
        if (string.IsNullOrWhiteSpace(terminoBusqueda))
        {
            listaProductos = await Http.GetFromJsonAsync<List<Producto>>("https://localhost:44300/api/Producto/lista") ?? new();
        }
        else
        {
            listaProductos = await Http.GetFromJsonAsync<List<Producto>>($"https://localhost:44300/api/Producto/buscar?termino={Uri.EscapeDataString(terminoBusqueda)}") ?? new();
        }
    }

    async Task ConfirmarEliminarProducto()
    {
        if (productoAEliminar != null)
        {
            var response = await Http.DeleteAsync($"api/producto/{productoAEliminar.Id}");
            if (response.IsSuccessStatusCode)
            {
                await CargarDatos();
                mostrarModalConfirmacion = false;
                productoAEliminar = null;
            }
        }
    }

    void MostrarConfirmacionEliminarProducto(Producto producto)
    {
        productoAEliminar = producto;
        mostrarModalConfirmacion = true;
    }

    public class Producto
    {
        public int Id { get; set; }
        public string Nombre { get; set; }
        public string Descripción { get; set; }
        public string Codigo { get; set; }
        public int CategoriaId { get; set; }
        public string? Color { get; set; }
        public string? Material { get; set; }
        public string? Peso { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
        public string ImagenURL { get; set; }
        public Categoria? Categoria { get; set; }

        public Producto() { }
    }

    public class Categoria
    {
        public int Id { get; set; }
        public string Nombre { get; set; }
    }
}

<style>
    /* Estilo general */

    .contenido {
        max-width: 1200px;
        margin: auto;
        background-color: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    /* Barra superior */
    .barra-superior {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .titulo-seccion {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
    }

    /* Botón agregar */
    .btn-agregar {
        background-color: #bb8e6b;
        color: #fff;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .btn-agregar:hover {
            background-color: #ede0d4;
            color: #bb8e6b;
        }

    /* Tabla */
    .tabla-contenedor {
        overflow-x: auto;
    }

    .tabla-productos {
        width: 100%;
        border-collapse: collapse;
    }

        .tabla-productos th,
        .tabla-productos td {
            padding: 0.5rem;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .tabla-productos th {
            background-color: #EAE6E3;
            font-weight: 600;
            color: #555;
        }

        .tabla-productos tr:hover {
            background-color: #F9F4EF;
        }

    /* Botones de iconos: editar y eliminar */
    .btn-icono {
        border: none;
        padding: 0.45rem 0.6rem;
        border-radius: 0.5rem;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Editar */
    .btn-editar {
        background-color: #ede0d4;
        color: #bb8e6b;
    }

        .btn-editar:hover {
            background-color: #d9a98b;
            color: #fff;
            transform: scale(1.08);
        }

    /* Eliminar */
    .btn-eliminar {
        background-color: #ede0d4;
        color: #bb8e6b;
    }

        .btn-eliminar:hover {
            background-color: #bb8e6b;
            color: #fff;
            transform: scale(1.08);
        }


    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
    }

    .modal-contenido {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        width: 90%;
        max-width: 700px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        position: relative;
    }

    /* Botón cerrar modal */
    .cerrar-modal {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    /* Formularios */
    .formulario-producto {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .columna label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 500;
        color: #374151;
    }

    .columna input,
    .columna select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
    }

    /* Mensaje error */
    .mensaje-error {
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: #dc2626;
    }

    /* Botones */
    .btn-registrar,
    .btn-eliminar-detalle {
        color: white;
        border: none;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 1rem;
        transition: background-color 0.2s ease;
    }

    .btn-eliminar-detalle {
        background-color: #ef4444;
    }

    .btn-registrar {
        background-color: #10b981;
    }

    .btn-eliminar-detalle:hover {
        background-color: #dc2626;
    }

    .btn-registrar:hover {
        background-color: #059669;

    }

</style>
