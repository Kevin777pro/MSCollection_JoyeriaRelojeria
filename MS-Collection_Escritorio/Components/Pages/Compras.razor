@page "/Compras"
@inject HttpClient Http

<div class="contenedor-principal">
    <main class="contenido">
        <div class="barra-superior">
            <div class="titulo-seccion">Gestión de compras</div>
            <button class="btn-agregar" @onclick="Agregarcompra">+ Nuevo compra</button>
        </div>
        <div class="input-group mb-3">
            <input @bind="terminoBusqueda" class="form-control" placeholder="Buscar compra..." />
            <button class="btn-agregar" @onclick="BuscarCompras">Buscar</button>
        </div>
        @if (comprasFiltradas != null)
        {
            <table class="tabla-productos">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Proveedor</th>
                        <th>Telefono</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var compra in comprasFiltradas)
                    {
                        <tr>
                            <td>@compra.Id</td>
                            <td>@compra.Proveedor?.Nombre</td>
                            <td>@compra.Proveedor?.Telefono</td>
                            <td>@compra.Fechacompra?.ToString("dd/MM/yyyy")</td>
                            <td>@compra.Total?.ToString("C")</td>
                            <td>
                                <button class="btn-agregar" @onclick="() => VerDetalleCompra(compra.Id)">Ver Detalle</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </main>

    @if (mostrarModal2)
    {
        <div class="modal-overlay">
            <div class="modal-contenido">
                <h3>Detalles del Compras #@compraSeleccionadoId</h3>
                <table class="tabla-productos">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in detallesCompra)
                        {
                            <tr>
                                <td>@detalle.NombreProducto</td>
                                <td>@detalle.Cantidad</td>
                                <td>@detalle.PrecioUnitario.ToString("C")</td>
                                <td>@detalle.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="btn-cerrar" @onclick="CerrarModal">Cerrar</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }
    <!-- Modal de Registro de compra -->
    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal-contenido compra-modal">
                <button class="cerrar-modal" @onclick="() => mostrarModal = false">×</button>
                <h2>Registrar compra</h2>
                @* Formulario *@
                <div class="formulario-producto">
                    <div class="columna">
                        <label>Proveedor:</label>
                        <select @bind="nuevocompra.ProveedorId">
                            <option value="">Seleccione un proveedor</option>
                            @foreach (var proveedor in proveedors)
                            {
                                <option value="@proveedor.Id">@proveedor.Nombre</option>
                            }
                        </select>
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorProveedor))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorProveedor</div>
                        }
                    </div>
                    <div class="columna">
                        <label>Producto:</label>
                        <select @onchange="ProductoSeleccionado">
                            <option value="">Seleccione un producto</option>
                            @foreach (var producto in productos)
                            {
                                <option value="@producto.Id">@producto.Nombre</option>
                            }
                        </select>
                        @*  Validación *@
                        @if (!string.IsNullOrWhiteSpace(errorProducto))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorProducto</div>
                        }
                    </div>

                    <div class="columna">
                        <label>Cantidad:</label>
                        <input type="number" @bind="detallecompraTemp.Cantidad" @oninput="CalcularTotal" /> @* Calculo de total *@
                        @if (!string.IsNullOrWhiteSpace(errorCantidad))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorCantidad</div>
                        }
                    </div>

                    <div class="columna">
                        <label>Precio de compra:</label>
                        <input type="number" step="0.01" @bind="detallecompraTemp.PrecioUnitario" />
                        @if (!string.IsNullOrWhiteSpace(errorPrecio))
                        {
                            <div class="mensaje-error"><i class="fas fa-exclamation-circle"></i> @errorPrecio</div>
                        }
                    </div>


                    <button class="btn-cambiarestado" @onclick="AgregarDetalle">+ Agregar Detalle</button>
                </div>

                @if (detallesTemp.Any())
                {
                    <div class="detalles-agregados">
                        <h4>Detalles del compra</h4>
                        <table class="tabla-productos">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unitario</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in detallesTemp)
                                {
                                    var nombreProducto = productos.FirstOrDefault(p => p.Id == detalle.ProductoId)?.Nombre;
                                    <tr>
                                        <td>@nombreProducto</td>
                                        <td>@detalle.Cantidad</td>
                                        <td>@detalle.PrecioUnitario</td>
                                        <td>@(detalle.Cantidad * detalle.PrecioUnitario)</td>
                                        <td>
                                            <button class="btn-eliminar-detalle" @onclick="() => EliminarDetalle(detalle)">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Total General -->
                        <div class="total-general">
                            <strong>Total del compra: </strong>
                            @detallesTemp.Sum(d => d.Cantidad * d.PrecioUnitario).ToString("C")
                        </div>
                    </div>
                }

                <button class="btn-registrar" @onclick="Guardarcompra">Registrar</button>
            </div>
        </div>
    }

</div>

@code {
    private List<DetalleCompraDTO> detallesCompra = new();
    private bool mostrarModal2 = false;
    private int compraSeleccionadoId;

    private async Task VerDetalleCompra(int compraId)
    {
        compraSeleccionadoId = compraId;
        detallesCompra = await Http.GetFromJsonAsync<List<DetalleCompraDTO>>($"https://localhost:44300/api/compra/detalle/{compraId}");
        mostrarModal2 = true;
    }

    private void CerrarModal()
    {
        mostrarModal2 = false;
        detallesCompra.Clear();
    }

    public class DetalleCompraDTO
    {
        public int ProductoId { get; set; }
        public string? NombreProducto { get; set; }
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal => Cantidad * PrecioUnitario;
    }
}

